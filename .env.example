# ============================================================
# AMBIENTE DEMONSTRATIVO
# ============================================================

APP_ENV=Development
APP_TIMEZONE=America/Sao_Paulo


# ============================================================
# POSTGRESQL
# Banco demonstrativo com dados ficticios
# ============================================================

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=ecossistema_portfolio
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME


# ============================================================
# USUARIO DO PORTAL NO POSTGRESQL
# ============================================================

PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_DATABASE=ecossistema_portfolio
PORTAL_DB_USER=portal_portfolio_app
PORTAL_DB_PASSWORD=CHANGE_ME


# ============================================================
# USUARIO DE LEITURA DO METABASE
# ============================================================

METABASE_DB_HOST=127.0.0.1
METABASE_DB_PORT=5432
METABASE_DB_DATABASE=ecossistema_portfolio
METABASE_DB_USER=metabase_portfolio_reader
METABASE_DB_PASSWORD=CHANGE_ME


# ============================================================
# BANCO INTERNO DO METABASE
# Armazena usuarios, perguntas, colecoes e dashboards
# ============================================================

METABASE_APP_DB_HOST=127.0.0.1
METABASE_APP_DB_PORT=5432
METABASE_APP_DB_DATABASE=metabase_portfolio_app
METABASE_APP_DB_USER=metabase_portfolio_app
METABASE_APP_DB_PASSWORD=CHANGE_ME


# ============================================================
# METABASE
# ============================================================

METABASE_BASE_URL=http://127.0.0.1:3001
METABASE_EMBEDDING_SECRET=CHANGE_ME

METABASE_DASHBOARD_SUPERIOR_ID=1
METABASE_DASHBOARD_EQUIPE_ID=2
METABASE_DASHBOARD_VENDEDOR_ID=3


# ============================================================
# PORTAL ASP.NET
# ============================================================

PORTAL_BASE_URL=http://127.0.0.1:5001
PORTAL_SESSION_KEY=CHANGE_ME


# ============================================================
# API DE NOTIFICACOES
# ============================================================

NOTIFICADOR_API_BASE_URL=http://127.0.0.1:5000
NOTIFICADOR_WEBHOOK_TOKEN=CHANGE_ME
NOTIFICADOR_CLIENT_TOKEN=CHANGE_ME


# ============================================================
# APLICATIVO DESKTOP
# ============================================================

DESKTOP_API_BASE_URL=http://127.0.0.1:5000
DESKTOP_CLIENT_TOKEN=CHANGE_ME
DESKTOP_INTERVAL_SECONDS=5


# ============================================================
# N8N
# ============================================================

N8N_BASE_URL=http://127.0.0.1:5678
N8N_ENCRYPTION_KEY=CHANGE_ME

N8N_POSTGRES_HOST=127.0.0.1
N8N_POSTGRES_PORT=5432
N8N_POSTGRES_DATABASE=ecossistema_portfolio
N8N_POSTGRES_USER=CHANGE_ME
N8N_POSTGRES_PASSWORD=CHANGE_ME


# ============================================================
# CRM / API EXTERNA
# Valores apenas demonstrativos
# ============================================================

CRM_BASE_URL=https://api.example.com
CRM_ACCESS_TOKEN=CHANGE_ME
CRM_OBJECTS_ENDPOINT=/crm/v3/objects/contacts/search
CRM_PAGE_LIMIT=200

# ============================================================
# IMAGENS DOS CONTAINERS
# Em um ambiente real, prefira versoes fixas e testadas.
# ============================================================

POSTGRES_IMAGE=postgres:16-alpine
METABASE_IMAGE=metabase/metabase:latest
N8N_IMAGE=n8nio/n8n:latest


# ============================================================
# BANCO INTERNO DO N8N
# Armazena workflows, credenciais criptografadas e execucoes.
# ============================================================

N8N_APP_DB_DATABASE=n8n_portfolio_app
N8N_APP_DB_USER=n8n_portfolio_app
N8N_APP_DB_PASSWORD=CHANGE_ME


# ============================================================
# ENDERECOS PUBLICOS DEMONSTRATIVOS
# ============================================================

PORTAL_PUBLIC_HOST=portal.example.com
API_PUBLIC_HOST=api.example.com
N8N_PUBLIC_HOST=n8n.example.com
METABASE_PUBLIC_HOST=dashboard.example.com

N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/